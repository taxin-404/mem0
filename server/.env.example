# LLM/embedder provider key (see server/main.py):
#   GOOGLE_API_KEY -> Gemini for LLM + embeddings (free AI Studio tier;
#                     defaults: gemini-3.5-flash-lite, models/gemini-embedding-001)
#   OPENAI_API_KEY -> OpenAI (defaults: gpt-5-mini, text-embedding-3-small)
# GOOGLE_API_KEY wins when both are set.
GOOGLE_API_KEY=
OPENAI_API_KEY=

# Postgres — POSTGRES_PASSWORD is required; docker-compose will not start without it.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_COLLECTION_NAME=memories

ADMIN_API_KEY=
JWT_SECRET=
# Local development only. Leave false in production.
AUTH_DISABLED=false
DASHBOARD_URL=http://localhost:3000
APP_DB_NAME=mem0_app

# Pin specific models without editing code. Leave blank to use the
# per-provider defaults from server/main.py (provider must be in
# BUNDLED_*_PROVIDERS — set the matching *_API_KEY above).
MEM0_DEFAULT_LLM_MODEL=
MEM0_DEFAULT_EMBEDDER_MODEL=

# Anonymous telemetry. Sends a single onboarding event per install
# (install UUID, email domain, server version, source). No PII.
# Set to false to opt out.
MEM0_TELEMETRY=true

# Days of request_logs history to keep when `make prune-logs` runs.
# Wire the prune command into cron/systemd in production.
REQUEST_LOG_RETENTION_DAYS=30
